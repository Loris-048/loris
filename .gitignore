# ============================================
# Loirs .gitignore — 本地全量跟踪，deploy只推线上文件
# ============================================

# 体积庞大的安装包（不进git）
*.exe
*.msi

# 图片（生成的输出文件太大，不跟踪）
*.png
*.jpg
*.jpeg
*.gif
*.webp

# 含 token/密钥的配置文件（防止泄露）
config.json

# 用户上传的临时文件
.uploads/

# node_modules（如有）
node_modules/

# 临时 zip 包
*.zip

# 系统文件
Thumbs.db
.DS_Store

# 本地开发源码（不应上传到 GitHub）
public/

# 本地打包输出（不应上传到 GitHub）
dist/

# 本地数据文件夹（不应上传到 GitHub）
Loirs_Data/

# 本地开发工具和测试文件（不应上传到 GitHub）
restore_chats.js
test_concurrent_saves.js
split.js

# AI 协作备份目录（临时回滚点，不应上传）
.workbuddy_backup/

# AI 临时工作目录（复现脚本 / 临时测试 / 日志，不应上传）
_wtmp/

# 老版 app.js 的人工快照备份（GBK 编码，无代码引用）
temp.txt

# build.js 已重新纳入版本管理（构建链核心，必须有回退保障）
# 保留忽略：以下文件含本机路径/密钥或属于运行时依赖，仅本地使用
deploy.bat
deploy.js
run.bat
server.js

# ========================================================================
# 2026-10-23 仓库精简：线上只保留 index.html / api/ / vercel.json
# 以下内容仅本地使用，不进 GitHub（本地文件照常保留，git rm --cached 移除）
# ========================================================================
# 源码与构建链（由 build.js 打包成单文件 index.html 后才上线）
public/
dist/
build.js
check_cross_module.js
check_exports.js
smoke_test_bundled.js
# 本地测试与工具
tests/
data/
user-management.js
# 文档（本地留存，不公开）
AI-工作说明.md
readme.txt
